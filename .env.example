# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="your_super_secret_jwt_key_here"

# STRIPE_SECRET_KEY: Your Stripe secret API key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=""

# STRIPE_PRICE_MONTHLY: The Price ID for your monthly subscription (starts with price_)
STRIPE_PRICE_MONTHLY=""

# STRIPE_PRICE_YEARLY: The Price ID for your yearly subscription (starts with price_)
STRIPE_PRICE_YEARLY=""

# Twilio (Optional for automatic background WhatsApp sending)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# Email Notifications (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@yourdomain.com"
ADMIN_EMAIL="gergesnabil101@gmail.com"

# Cloudflare Turnstile & Bot Protection
TURNSTILE_SECRET_KEY=""
TURNSTILE_SITE_KEY=""

# Firebase App Check & Attempt Token Security
ENFORCE_APP_CHECK="false"
ATTEMPT_TOKEN_SECRET="quiz_attempt_secret_signing_key_2026"

# GOOGLE_APPLICATION_CREDENTIALS_JSON: Service-account JSON inline (single line).
# Required only when hosting outside Google Cloud (Render, Railway, VPS...).
# On Cloud Run this is NOT needed — the service's identity is automatic.
# Get it from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS_JSON=""
