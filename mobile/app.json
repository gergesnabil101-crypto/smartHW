{
  "expo": {
    "name": "مصحح الواجبات الذكي",
    "slug": "smart-homework-grader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mosahah",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gergesnabil.mosahah"
    },
    "android": {
      "package": "com.gergesnabil.mosahah",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بإرفاق صور في الإجابات المقالية",
          "cameraPermission": "التقاط صورة لإرفاقها في الإجابة"
        }
      ],
      "expo-iap",
      "expo-audio",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "apiBaseUrl": "https://mosahah-api-609470896445.europe-west1.run.app",
      "paymentsMode": "iap",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "629e3471-3c32-49ee-ade2-20df3144bfaf"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "owner": "gergesnabil101"
  }
}
