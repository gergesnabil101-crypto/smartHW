{
  "expo": {
    "name": "مصحح الواجبات الذكي",
    "slug": "smart-homework-grader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mosahah",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gergesnabil.mosahah"
    },
    "android": {
      "package": "com.gergesnabil.mosahah",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4f46e5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "السماح بإرفاق صور في الإجابات المقالية",
          "cameraPermission": "التقاط صورة لإرفاقها في الإجابة"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://REPLACE-WITH-YOUR-BACKEND.run.app",
      "router": {}
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
