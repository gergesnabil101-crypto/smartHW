# Public runtime config for the mobile app (safe values only — no secrets here)
# Base URL of the deployed backend (server.ts) — same one the web app uses.
# Example: https://your-service-abc123.run.app
EXPO_PUBLIC_API_URL="https://REPLACE-WITH-YOUR-BACKEND.run.app"

# Google Sign-In — the WEB OAuth 2.0 client ID of the Firebase project
# (Firebase Console → Authentication → Sign-in method → Google → Web SDK config).
# Without it the Google button stays disabled. Also create an ANDROID OAuth
# client (package com.gergesnabil.mosahah + SHA-1 of the signing keystore).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
